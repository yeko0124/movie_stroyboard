# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 서버를 켤 때 자동으로 읽힙니다.

# 초대 코드. 비워 두면 코드 없이 누구나 들어온다 (기본값).
# 나중에 잠그고 싶으면 아래 줄의 주석을 풀고 원하는 코드를 넣으세요.
# INVITE_CODE=cut-01

# 서버 포트. 이미 쓰는 포트면 8081 등으로 바꾸세요.
PORT=8080

# 한 파일당 최대 업로드 용량 (MB)
MAX_UPLOAD_MB=2048

# ── 저장소 ───────────────────────────────────────────────
# local = 이 폴더의 media/ 에 저장 (기본값)
# r2    = Cloudflare R2 에 저장 — 로컬 디스크를 쓰지 않는다
STORAGE_BACKEND=local

# STORAGE_BACKEND=r2 로 바꿀 때만 채우면 됩니다.
# 먼저 pip install boto3 가 필요합니다.
# R2_ACCOUNT_ID=
# R2_BUCKET=storyboard
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
